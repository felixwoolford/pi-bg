{
  "name": "shell-background",
  "version": "0.1.1",
  "description": "Explicit background shell jobs for Pi, with user-triggered foreground transfer, status tools, and completion delivery",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "bash",
    "background",
    "async",
    "shell"
  ],
  "homepage": "https://github.com/felixwoolford/shell-background#readme",
  "bugs": {
    "url": "https://github.com/felixwoolford/shell-background/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixwoolford/shell-background.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "os": [
    "!win32"
  ],
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "22.20.5",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "private"
  }
}
